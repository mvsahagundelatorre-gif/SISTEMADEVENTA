# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de JWT
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=24h

# Configuración de Email (Gmail)
# Para usar Gmail, debes habilitar "Contraseñas de aplicación" en tu cuenta de Google
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion

# Nombre de la aplicación (aparece en los correos)
APP_NAME=Sistema de Venta
APP_URL=http://localhost:3000
